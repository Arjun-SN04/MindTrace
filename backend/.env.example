# Copy to .env and adjust. Never commit .env.
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Optional. Without it, saves are kept in memory and lost on restart.
MONGODB_URI=mongodb://127.0.0.1:27017/mindtrace
# Reserved for the AI interrogation milestone. Keys stay on the server only.
LLM_PROVIDER=none
LLM_API_KEY=
